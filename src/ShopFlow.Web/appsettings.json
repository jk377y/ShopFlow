{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Listen on the loopback address only, so other machines on the network can't reach the app.
  // 127.0.0.1 (not "localhost") avoids IPv4/IPv6 surprises. Override with the Urls env var if needed.
  "Urls": "http://127.0.0.1:5080",
  // Reject requests whose Host header isn't local. No authentication in v1, so this is a cheap extra guard.
  "AllowedHosts": "localhost;127.0.0.1"
}
